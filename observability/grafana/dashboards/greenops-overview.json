{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(greenops_http_requests_total[1m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP P95 Latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(greenops_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Generation P95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(greenops_ai_generation_duration_seconds_bucket[5m])))",
          "legendFormat": "LLM p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Embedding P95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(greenops_embedding_duration_seconds_bucket[5m])))",
          "legendFormat": "Embedding p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAG Retrieval P95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(greenops_rag_retrieval_duration_seconds_bucket[5m])))",
          "legendFormat": "RAG p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Agent Tool Calls",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (tool, outcome) (rate(greenops_agent_tool_calls_total[5m]))",
          "legendFormat": "{{tool}} - {{outcome}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "greenops",
    "ai",
    "observability"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "GreenOps AI Observability",
  "version": 1
}